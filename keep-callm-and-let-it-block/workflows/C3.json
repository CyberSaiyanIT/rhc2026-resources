        "inputSchema": "{\"type\": \"object\", \"properties\": {\"block\": {\"type\": \"boolean\"}, \"confidence\": {\"type\": \"number\", \"minimum\": 0, \"maximum\": 1}, \"reasoning\": {\"type\": \"string\"}, \"evidence\": {\"type\": \"array\", \"items\": {\"type\": \"string\"}}}, \"required\": [\"block\", \"confidence\", \"reasoning\", \"evidence\"], \"additionalProperties\": false}"
      }
    },
